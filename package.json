{
  "name": "queueme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build && mkdir -p ./dist && cp -r client/dist/* ./dist/ 2>/dev/null || true",
    "preview": "npm --prefix client run preview",
    "server": "npm --prefix server run start",
    "server:dev": "npm --prefix server run dev",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:seed": "npm --prefix server run prisma:seed",
    "prisma:studio": "npm --prefix server run prisma:studio",
    "test:backend": "npm --prefix server run test",
    "test:persistence": "node server/test/persistence.test.js",
    "test:phase2": "node server/test/phase2.test.js",
    "test:qa": "node server/test/qa_audit.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "vite": "^8.3.0"
  }
}
