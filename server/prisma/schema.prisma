generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MediaType {
  movie
  video
  article
  book
  course
  audio
}

enum ItemStatus {
  queued
  in_progress
  completed
}

enum ItemPriority {
  high
  medium
  low
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  password  String?      // Nullable for Google OAuth users, hashed for Email users
  name      String?
  avatarUrl String?
  provider  AuthProvider @default(LOCAL)
  googleId  String?      @unique
  items     Item[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("users")
}

model Item {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  type          MediaType
  creator       String       @default("")
  platform      String       @default("")
  duration      String       @default("")
  progress      Int          @default(0)
  progressLabel String       @default("Not started")
  status        ItemStatus   @default(queued)
  priority      ItemPriority @default(medium)
  releaseYear   String?
  rating        String?
  tags          String[]     @default([])
  coverImage    String?
  url           String?
  sourceUrl     String?
  notes         String?
  addedDate     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@map("items")
}
